{
  "name": "flyer-galicia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "vite build",
    "release": "vite build && node scripts/release.ts",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:policy": "node scripts/check-lint-policy.ts",
    "lint:boundaries": "depcruise web/src scripts tests --config .dependency-cruiser.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contract:record": "FLYER_RECORD_CONTRACT=1 playwright test --project=legacy",
    "perf:baseline": "node scripts/measure-performance.ts",
    "demo:commercial-actions": "node scripts/demo-commercial-actions.ts",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir storybook-static --quiet",
    "legacy:build": "node scripts/legacy-build.ts",
    "db:types": "node scripts/generate-database-types.ts",
    "ci": "npm run lint:policy && npm run format:check && npm run lint && npm run lint:boundaries && npm run typecheck && npm test && npm run release && npm run legacy:build && npm run storybook:build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.5",
    "@swc/core": "1.16.21",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.13.0 <27",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "@swc/core@1.16.21": true
  }
}
